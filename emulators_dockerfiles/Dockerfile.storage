# Dockerfile for Firebase Storage Emulator
FROM eclipse-temurin:11-jdk

# Install Node.js
RUN curl -sL https://deb.nodesource.com/setup_18.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Install the Firebase CLI
RUN npm install -g firebase-tools

# Setup the Storage emulator
RUN firebase setup:emulators:storage

# Create app directory
WORKDIR /app

# Copy configuration files
COPY firebase.json /app/
COPY storage.rules /app/

# Expose the Storage emulator port (from your firebase.json)
EXPOSE 9094

# Set environment variable for port (Render compatibility)
ENV PORT=9094

# Start the Storage emulator
CMD ["firebase", "emulators:start", "--only", "storage", "--project", "ruxailab-dev"]