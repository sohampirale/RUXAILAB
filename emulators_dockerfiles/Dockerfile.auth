# Dockerfile for Firebase Auth Emulator
FROM eclipse-temurin:11-jdk

# Install Node.js
RUN curl -sL https://deb.nodesource.com/setup_18.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Install the Firebase CLI
RUN npm install -g firebase-tools

# Create app directory
WORKDIR /app

# Copy configuration files
COPY firebase.json /app/

# Expose the Auth emulator port (from your firebase.json)
EXPOSE 9092

# Set environment variable for port (Render compatibility)
ENV PORT=9092

# Start the Auth emulator
CMD ["firebase", "emulators:start", "--only", "auth", "--project", "ruxailab-dev"]